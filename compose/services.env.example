# Stable Docker Compose project name across deploy paths
COMPOSE_PROJECT_NAME=stoganet-edge

# Public domain served by Caddy (jellyfin.${DOMAIN}, seerr.${DOMAIN}, ...)
DOMAIN=example.com

# Email used for ACME / Let's Encrypt registration
ACME_EMAIL=admin@example.com

# NetBird overlay IP of the home server (target for Caddy reverse proxies)
NETBIRD_HOME_IP=100.x.x.x
