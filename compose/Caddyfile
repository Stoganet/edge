{
	email {$ACME_EMAIL}
}

netbird.stoganet.com {
	# Native gRPC (needs HTTP/2 cleartext to backend)
	@grpc header Content-Type application/grpc*
	reverse_proxy @grpc h2c://netbird-server:80

	# Combined server paths (relay, signal, management, OAuth2)
	@backend path /relay* /ws-proxy/* /api/* /oauth2/*
	reverse_proxy @backend netbird-server:80

	# Dashboard (everything else)
	reverse_proxy /* netbird-dashboard:80
}

jellyfin.{$DOMAIN} {
	log {
		output file /var/log/caddy/jellyfin.log
		format json
	}
	rate_limit {
		zone jellyfin_auth {
			key {remote_host}
			match {
				path /Users/AuthenticateByName /emby/Users/AuthenticateByName /Users/AuthenticateWithQuickConnect /QuickConnect/Authorize /QuickConnect/Initiate
			}
			events 10
			window 1m
		}
	}
	reverse_proxy https://{$NETBIRD_HOME_IP} {
		header_up Host jellyfin.{$DOMAIN}
		transport http {
			tls_server_name jellyfin.{$DOMAIN}
		}
	}
}

seerr.{$DOMAIN} {
	log {
		output file /var/log/caddy/seerr.log
		format json
	}
	rate_limit {
		zone seerr_auth {
			key {remote_host}
			match {
				path /api/v1/auth/jellyfin /api/v1/auth/local /api/v1/auth/plex /api/v1/auth/reset-password
			}
			events 10
			window 1m
		}
	}
	reverse_proxy https://{$NETBIRD_HOME_IP} {
		header_up Host seerr.{$DOMAIN}
		transport http {
			tls_server_name seerr.{$DOMAIN}
		}
	}
}

api.{$DOMAIN} {
	log {
		output file /var/log/caddy/api-proxy.log
		format json
	}
	rate_limit {
		zone api {
			key {remote_host}
			events 60
			window 1m
		}
	}
	reverse_proxy https://{$NETBIRD_HOME_IP} {
		header_up Host api.{$DOMAIN}
		transport http {
			tls_server_name api.{$DOMAIN}
		}
	}
}
