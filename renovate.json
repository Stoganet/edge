{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Helsinki",
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": true,
      "matchUpdateTypes": ["digest", "patch", "minor"]
    },
    {
      "matchManagers": ["docker-compose", "dockerfile"],
      "excludePackageNames": ["traefik", "netbirdio/netbird-server", "netbirdio/dashboard"],
      "groupName": "all other non-major dependencies",
      "automerge": true,
      "matchUpdateTypes": ["digest", "patch", "minor"]
    },
    {
      "matchManagers": ["docker-compose", "dockerfile", "custom.regex"],
      "matchDepNames": ["netbirdio/netbird", "netbirdio/netbird-server", "netbirdio/dashboard"],
      "groupName": "netbird",
      "automerge": true,
      "matchUpdateTypes": ["digest", "patch"]
    },
    {
      "matchManagers": ["docker-compose", "dockerfile", "custom.regex"],
      "matchDepNames": ["netbirdio/netbird", "netbirdio/netbird-server", "netbirdio/dashboard"],
      "groupName": "netbird",
      "automerge": false,
      "matchUpdateTypes": ["minor", "major"],
      "labels": ["review-needed"]
    },
    {
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchPackageNames": ["traefik"],
      "groupName": "traefik",
      "automerge": true,
      "matchUpdateTypes": ["digest", "patch"]
    },
    {
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchPackageNames": ["traefik"],
      "groupName": "traefik",
      "automerge": false,
      "matchUpdateTypes": ["minor", "major"],
      "labels": ["review-needed"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/deploy\\.yml$"],
      "matchStrings": ["NB_VERSION:\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "netbirdio/netbird",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
